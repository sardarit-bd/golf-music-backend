# ========================================================
# Gulf Coast Music API - Environment Configuration Template
# Copy this file to .env and replace placeholders with actual values
# DO NOT commit the .env file containing real secrets to version control
# ========================================================

# --------------------------------------------------------
# 1. Server Configuration
# --------------------------------------------------------
NODE_ENV=development
PORT=5000

# --------------------------------------------------------
# 2. Database Configuration
# --------------------------------------------------------
# MongoDB Atlas Connection URI or local MongoDB instance
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/golfmusic

# --------------------------------------------------------
# 3. JWT Authentication
# --------------------------------------------------------
# Generate a strong 64-character hex secret: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d

# --------------------------------------------------------
# 4. Frontend Application URLs (CORS & Redirects)
# --------------------------------------------------------
# Main client URL for CORS, Stripe redirect callbacks, and email links
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --------------------------------------------------------
# 5. Email Service (Nodemailer / SMTP)
# --------------------------------------------------------
# Supported service: gmail (or configure custom SMTP in emailService.js)
EMAIL_SERVICE=gmail
EMAIL_USERNAME=your-account@gmail.com
EMAIL_PASSWORD=your-google-app-password
# Used for password reset sender address:
SMTP_EMAIL=your-account@gmail.com

# --------------------------------------------------------
# 6. Cloudinary Configuration (Media Storage)
# --------------------------------------------------------
# Obtain from Cloudinary Console Dashboard
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --------------------------------------------------------
# 7. Stripe Configuration (Payments, Subscriptions & Connect)
# --------------------------------------------------------
# Stripe API Secret Key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Stripe Webhook Signing Secret (starts with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Stripe Recurring Price ID for Pro Plan ($10/month)
STRIPE_PRICE_PRO=price_your_stripe_price_id
